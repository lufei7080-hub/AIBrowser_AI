{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "天枢台",
  "version": "0.1.0",
  "identifier": "com.cloakforge.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "天枢台",
        "width": 1440,
        "height": 900,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "visible": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
